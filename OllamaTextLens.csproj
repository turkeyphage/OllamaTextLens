<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OllamaTextLens</AssemblyName>
    <RootNamespace>OllamaTextLens</RootNamespace>
    <Product>OllamaTextLens</Product>
    <Title>OllamaTextLens</Title>
    <Description>Windows text translation and plain-language explanations powered by local Ollama models.</Description>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
</Project>
