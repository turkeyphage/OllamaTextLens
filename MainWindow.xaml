<Window x:Class="OllamaTextLens.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OllamaTextLens" Width="760" Height="850" SizeToContent="Height" WindowStartupLocation="CenterScreen" MinWidth="490" MinHeight="440" Background="#F4F6FA" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28">
    <StackPanel Orientation="Horizontal">
      <Image Source="Assets/logo.png" Width="40" Height="40" Margin="0,0,12,0"/>
      <TextBlock Text="OllamaTextLens" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="HelpLabel" Margin="0,12,0,20" TextWrapping="Wrap"/>
    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock x:Name="ConnectionStatus" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="RunningModelStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#334155"/>
        <TextBlock x:Name="SelectedModelStatus" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#64748B"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="InterfaceLabel" TextWrapping="Wrap"/>
    <ComboBox x:Name="InterfaceLanguage" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Language_Changed" Margin="0,6,0,12" Padding="8"/>
    <TextBlock x:Name="TargetLabel" TextWrapping="Wrap"/>
    <ComboBox x:Name="TargetLanguage" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Language_Changed" Margin="0,6,0,12" Padding="8"/>
    <TextBlock x:Name="EndpointLabel" TextWrapping="Wrap"/>
    <TextBox x:Name="Endpoint" Margin="0,6,0,12" Text="http://127.0.0.1:11434"/>
    <TextBlock x:Name="ModelLabel" TextWrapping="Wrap"/>
    <ComboBox x:Name="Models" IsEditable="True" Margin="0,6,0,18" Padding="8"/>
    <WrapPanel>
      <Button x:Name="RefreshButton" Click="Refresh_Click" Margin="0,0,8,8"/>
      <Button x:Name="SaveButton" Click="Save_Click" Margin="0,0,8,8"/>
      <Button x:Name="TestButton" Click="Test_Click" Margin="0,0,8,8"/>
    </WrapPanel>
    <TextBlock x:Name="Status" Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#334155"/>
    <TextBlock x:Name="PrivacyLabel" Margin="0,16,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
  </StackPanel>
  </ScrollViewer>
</Window>
